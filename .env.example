CANVAS_BASE_URL=          # or use the API with a token
CANVAS_TOKEN=
OUTLOOK_CLIENT_ID=
OUTLOOK_TENANT=common
# Gmail and Google Calendar: put your OAuth desktop client in google_credentials.json
